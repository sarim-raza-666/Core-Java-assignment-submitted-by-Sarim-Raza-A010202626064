import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.sql.*;

public class EmployeeManagement extends JFrame {

    private JTextField txtId, txtName, txtDepartment, txtSalary;
    private JTable table;
    private DefaultTableModel model;

    public EmployeeManagement() {

        setTitle("Employee Management System");
        setSize(750, 500);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        // Creating input fields
        JPanel panel = new JPanel(new GridLayout(5, 2, 10, 10));

        txtId = new JTextField();
        txtName = new JTextField();
        txtDepartment = new JTextField();
        txtSalary = new JTextField();

        panel.add(new JLabel("Employee ID:"));
        panel.add(txtId);

        panel.add(new JLabel("Employee Name:"));
        panel.add(txtName);

        panel.add(new JLabel("Department:"));
        panel.add(txtDepartment);

        panel.add(new JLabel("Salary:"));
        panel.add(txtSalary);

        // Creating buttons
        JButton btnSubmit = new JButton("Submit");
        JButton btnView = new JButton("View All Employees");

        panel.add(btnSubmit);
        panel.add(btnView);

        // Creating employee table
        model = new DefaultTableModel(
            new String[]{"ID", "Name", "Department", "Salary"}, 0
        );

        table = new JTable(model);

        add(panel, BorderLayout.NORTH);
        add(new JScrollPane(table), BorderLayout.CENTER);

        // Button actions
        btnSubmit.addActionListener(e -> addEmployee());
        btnView.addActionListener(e -> viewEmployees());

        setVisible(true);
    }

    // Saving employee details into the database
    private void addEmployee() {

        String sql = "INSERT INTO employees VALUES (?, ?, ?, ?)";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setInt(1, Integer.parseInt(txtId.getText()));
            ps.setString(2, txtName.getText());
            ps.setString(3, txtDepartment.getText());
            ps.setBigDecimal(4,
                new java.math.BigDecimal(txtSalary.getText()));

            ps.executeUpdate();

            JOptionPane.showMessageDialog(this,
                "Employee details added successfully!");

            // Clearing the fields after saving
            txtId.setText("");
            txtName.setText("");
            txtDepartment.setText("");
            txtSalary.setText("");

        } catch (Exception ex) {

            JOptionPane.showMessageDialog(this,
                "Unable to add employee: " + ex.getMessage());
        }
    }

    // Displaying all employee records in the table
    private void viewEmployees() {

        model.setRowCount(0);

        String sql = "SELECT * FROM employees";

        try (Connection con = DBConnection.getConnection();
             Statement st = con.createStatement();
             ResultSet rs = st.executeQuery(sql)) {

            while (rs.next()) {

                model.addRow(new Object[]{
                    rs.getInt("emp_id"),
                    rs.getString("name"),
                    rs.getString("department"),
                    rs.getBigDecimal("salary")
                });
            }

        } catch (SQLException ex) {

            JOptionPane.showMessageDialog(this,
                "Unable to display employees: " + ex.getMessage());
        }
    }

    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {
            new EmployeeManagement();
        });
    }
}